+// FIDES_TWISTED_PRODUCT_V1
+namespace {
+int NormalizeTwistedProductIndex(int index, int ringDimension) {
+	index %= ringDimension / 2;
+	if (index < 0)
+		index += ringDimension / 2;
+	return index;
+}
+}
+
+void ContextData::AddTwistedProductKeys(
+  int index, KeySwitchingKey&& t_to_s, KeySwitchingKey&& st_to_s) {
+	index = NormalizeTwistedProductIndex(index, N);
+	if (t_to_s.keyID != st_to_s.keyID)
+		throw std::invalid_argument("twisted-product key IDs do not match");
+	if (!precom.keys.contains(t_to_s.keyID))
+		precom.keys[t_to_s.keyID] = Precomputations::KeyPrecomputations{};
+	auto& keys = precom.keys.at(t_to_s.keyID);
+	keys.twisted_t_keys.erase(index);
+	keys.twisted_st_keys.erase(index);
+	keys.twisted_t_keys.emplace(index, std::move(t_to_s));
+	keys.twisted_st_keys.emplace(index, std::move(st_to_s));
+}
+
+KeySwitchingKey& ContextData::GetTwistedProductTKey(
+  int index, const KeyHash& keyID) {
+	index = NormalizeTwistedProductIndex(index, N);
+	if (!HasTwistedProductKeys(index, keyID))
+		throw std::runtime_error("twisted-product t->s key not found for index " +
+		                         std::to_string(index));
+	return precom.keys.at(keyID).twisted_t_keys.at(index);
+}
+
+KeySwitchingKey& ContextData::GetTwistedProductSTKey(
+  int index, const KeyHash& keyID) {
+	index = NormalizeTwistedProductIndex(index, N);
+	if (!HasTwistedProductKeys(index, keyID))
+		throw std::runtime_error("twisted-product st->s key not found for index " +
+		                         std::to_string(index));
+	return precom.keys.at(keyID).twisted_st_keys.at(index);
+}
+
+bool ContextData::HasTwistedProductKeys(int index, const KeyHash& keyID) {
+	index = NormalizeTwistedProductIndex(index, N);
+	if (!precom.keys.contains(keyID))
+		return false;
+	const auto& keys = precom.keys.at(keyID);
+	return keys.twisted_t_keys.contains(index) &&
+	       keys.twisted_st_keys.contains(index);
+}
