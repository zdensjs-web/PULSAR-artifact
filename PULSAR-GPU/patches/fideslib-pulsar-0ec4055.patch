+// FIDES_AFFINE_SKEW_SQUARE_V1
+void Ciphertext::affineSkewSquare(
+  const Ciphertext& g,
+  Ciphertext& out_g,
+  Ciphertext* out_p,
+  const int index) const {
+	CudaNvtxRange range("AffineSkewSquareRank2Direct");
+	CKKS::SetCurrentContext(cc_);
+	if (keyID != g.keyID)
+		throw std::invalid_argument("affine skew state key IDs differ");
+
+	// P and G leave a prefix level with different scale metadata: P is the
+	// product coordinate, while G includes an affine addition.  Align copies
+	// once here so both module projections use exactly the same P state.
+	Ciphertext p(cc_);
+	Ciphertext g_aligned(cc_);
+	p.copy(*this);
+	g_aligned.copy(g);
+	if (cc.rescaleTechnique == FIXEDAUTO ||
+	    cc.rescaleTechnique == FLEXIBLEAUTO ||
+	    cc.rescaleTechnique == FLEXIBLEAUTOEXT) {
+		if (!p.adjustForMult(g_aligned) && !g_aligned.adjustForMult(p))
+			throw std::runtime_error("cannot align affine skew coordinates");
+	}
+	if (p.getLevel() != g_aligned.getLevel() ||
+	    p.NoiseLevel != 1 || g_aligned.NoiseLevel != 1)
+		throw std::runtime_error("invalid aligned affine skew metadata");
+
+	const int normalized_index = normalyzeIndex(index);
+	if (normalized_index == 0)
+		throw std::invalid_argument("affine skew square requires a nonzero automorphism");
+	KeySwitchingKey& t_to_s =
+	  cc.GetTwistedProductTKey(normalized_index, keyID);
+	KeySwitchingKey& st_to_s =
+	  cc.GetTwistedProductSTKey(normalized_index, keyID);
+
+	// Keep sigma(P) and sigma(G) in their raw t=sigma(s) secret basis.  No
+	// standalone rotation key switch or intermediate ModDown is performed.
+	Ciphertext sigma_g(cc_);
+	sigma_g.copy(g_aligned);
+	sigma_g.automorph(normalized_index, 1);
+	Ciphertext sigma_p(cc_);
+	if (out_p != nullptr) {
+		sigma_p.copy(p);
+		sigma_p.automorph(normalized_index, 1);
+	}
+
+	// Project one coordinate P*sigma(rhs) from {1,s,t,s*t} back to {1,s}.
+	// Invoking this closure for eG and (when live) eP is the scalarized GPU
+	// realization of one rank-2 module operation.  Key lookup and metadata
+	// alignment are shared, while each live coordinate needs its own ModDown.
+	auto project_coordinate = [&](const Ciphertext& rhs,
+	                              const Ciphertext& sigma_rhs,
+	                              Ciphertext& out) {
+		const int level = p.c0.getLevel();
+		RNSPoly d00(cc, level);
+		RNSPoly ds(cc, level);
+		RNSPoly dt(cc, level);
+		RNSPoly dst(cc, level);
+		d00.multElement(p.c0, sigma_rhs.c0);
+		ds.multElement(p.c1, sigma_rhs.c0);
+		dt.multElement(p.c0, sigma_rhs.c1);
+		dst.multElement(p.c1, sigma_rhs.c1);
+
+		dt.modup();
+		dst.modup();
+		RNSPoly dt0(cc, level), dt1(cc, level);
+		RNSPoly dst0(cc, level), dst1(cc, level);
+		for (RNSPoly* component : {&dt0, &dt1, &dst0, &dst1})
+			component->generateSpecialLimbs(false, false);
+		dt1.dotKSKfused(dt0, dt, t_to_s.a, t_to_s.b, &dt);
+		dst1.dotKSKfused(dst0, dst, st_to_s.a, st_to_s.b, &dst);
+		for (RNSPoly* component : {&dt0, &dt1, &dst0, &dst1})
+			component->SetModUp(true);
+
+		out.c0.copy(d00);
+		out.c1.copy(ds);
+		out.extend(true);
+		out.c0.add(dt0);
+		out.c1.add(dt1);
+		out.c0.add(dst0);
+		out.c1.add(dst1);
+		out.modDown(false);
+		out.multMetadata(p, rhs);
+	};
+
+	// eG coordinate: G + P*sigma(G).
+	project_coordinate(g_aligned, sigma_g, out_g);
+	out_g.add(g_aligned);
+
+	// eP coordinate: P*sigma(P).  It is dead after the final prefix level.
+	if (out_p != nullptr)
+		project_coordinate(p, sigma_p, *out_p);
+}
+
+// FIDES_TWISTED_PRODUCT_V1
+void Ciphertext::twistedProduct(const Ciphertext& rhs, const int index__, bool rescale) {
+	CudaNvtxRange range("TwistedProduct");
+	CKKS::SetCurrentContext(cc_);
+	assert(keyID == rhs.keyID);
+
+	if (cc.rescaleTechnique == FIXEDAUTO || cc.rescaleTechnique == FLEXIBLEAUTO ||
+	    cc.rescaleTechnique == FLEXIBLEAUTOEXT) {
+		if (c0.isModUp() || c1.isModUp() || rhs.c0.isModUp() || rhs.c1.isModUp()) {
+			assert(getLevel() == rhs.getLevel());
+			assert(NoiseLevel == rhs.NoiseLevel);
+		}
+		if (!adjustForMult(rhs)) {
+			Ciphertext adjusted_rhs(cc_);
+			adjusted_rhs.copy(rhs);
+			if (!adjusted_rhs.adjustForMult(*this))
+				throw std::runtime_error("cannot align twisted-product operands");
+			twistedProduct(adjusted_rhs, index__, rescale);
+			return;
+		}
+	}
+
+	assert(NoiseLevel == 1);
+	assert(rhs.NoiseLevel == 1);
+	const int index = normalyzeIndex(index__);
+	if (index == 0)
+		throw std::invalid_argument("twisted product requires a nonzero automorphism");
+
+	KeySwitchingKey& t_to_s = cc.GetTwistedProductTKey(index, keyID);
+	KeySwitchingKey& st_to_s = cc.GetTwistedProductSTKey(index, keyID);
+
+	// Raw sigma(rhs): no rotation key switch and no ModDown.  Its components
+	// decrypt under t = sigma(s), which is why the mixed basis is required.
+	Ciphertext sigma_rhs(cc_);
+	sigma_rhs.copy(rhs);
+	sigma_rhs.automorph(index, 1);
+
+	const int level = c0.getLevel();
+	RNSPoly d00(cc, level);  // a0*b0, basis 1
+	RNSPoly ds(cc, level);   // a1*b0, basis s
+	RNSPoly dt(cc, level);   // a0*b1, basis t
+	RNSPoly dst(cc, level);  // a1*b1, basis s*t
+	d00.multElement(c0, sigma_rhs.c0);
+	ds.multElement(c1, sigma_rhs.c0);
+	dt.multElement(c0, sigma_rhs.c1);
+	dst.multElement(c1, sigma_rhs.c1);
+
+	// Materialize both mixed key switches in QP.  Unlike Rotate->Mult, no
+	// intermediate result is reduced to Q before the ciphertext product.
+	dt.modup();
+	dst.modup();
+	RNSPoly dt0(cc, level), dt1(cc, level);
+	RNSPoly dst0(cc, level), dst1(cc, level);
+	for (RNSPoly* out : { &dt0, &dt1, &dst0, &dst1 })
+		out->generateSpecialLimbs(false, false);
+	dt1.dotKSKfused(dt0, dt, t_to_s.a, t_to_s.b, &dt);
+	dst1.dotKSKfused(dst0, dst, st_to_s.a, st_to_s.b, &dst);
+	for (RNSPoly* out : { &dt0, &dt1, &dst0, &dst1 })
+		out->SetModUp(true);
+
+	// Embed the 1 and s terms as P*d00 and P*ds, add both switching-key
+	// contributions in QP, and perform exactly one output ModDown.
+	c0.copy(d00);
+	c1.copy(ds);
+	extend(true);
+	c0.add(dt0);
+	c1.add(dt1);
+	c0.add(dst0);
+	c1.add(dst1);
+	modDown(false);
+
+	this->multMetadata(*this, rhs);
+	if (rescale && cc.rescaleTechnique == CKKS::FIXEDMANUAL)
+		this->rescale();
+}
